// vectors_tests: the hash and the signature check against published
// vectors.
//
//   novo test tests/vectors_tests.nv
//
// SHA-256: the RFC 6234 § 8.5 test cases TEST1, TEST2_1, TEST3 (a
// million "a"), TEST4 and the empty message, which FIPS 180-4's examples
// share.  Ed25519: the RFC 8032 § 7.1 tests 1, 2, 3, 1024 and the SHA(abc)
// test, each valid as published and refused with one bit changed in the
// message, R, S or the key, and the malleability case of S + L.

use std.test
use std.bytes
use bytes32
use imghash
use ed25519
use hostsrc

fn hexb(h: Str) -> Bytes
    bytes.from_hex(h) ?? bytes.zeros(0)

fn to32(b: Bytes) -> B32
    var out = b32_zero()
    for i in 0..32
        out.put(i, (bytes.byte_at(b, i) ?? 0))
    out

fn to64(b: Bytes) -> B64
    var out = b64_zero()
    for i in 0..64
        out.put(i, (bytes.byte_at(b, i) ?? 0))
    out

fn hex32(b: B32) -> Str
    var out = bytes.zeros(32)
    for i in 0..32
        out = bytes.set_u8(out, i, b.at(i))
    bytes.to_hex(out)

fn sha_hex(msg: Bytes) -> Str
    hex32(imghash.sha256_of(hostsrc.bytes_src(msg)))

fn rep(s: Str, n: Int) -> Bytes
    let one = bytes.from_str(s)
    var out = bytes.zeros(bytes.len(one) * n)
    for k in 0..n
        for i in 0..bytes.len(one)
            out = bytes.set_u8(out, k * bytes.len(one) + i, (bytes.byte_at(one, i) ?? 0))
    out

@test
fn test_sha256_rfc6234()
    test.assert_eq_str(sha_hex(hexb("")),
                       "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    // TEST1
    test.assert_eq_str(sha_hex(bytes.from_str("abc")),
                       "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    // TEST2_1, 56 bytes: the padding takes a second block
    test.assert_eq_str(sha_hex(bytes.from_str("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
                       "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    // TEST4, "01234567" times 80
    test.assert_eq_str(sha_hex(rep("0123456701234567012345670123456701234567012345670123456701234567", 10)),
                       "594847328451bdfa85056225462cc1d867d877fb388df0ce35f25ab5562bfbb5")

@test
fn test_sha256_million_a()
    // TEST3, a million "a"
    test.assert_eq_str(sha_hex(rep("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 10000)),
                       "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")

// The RFC 8032 § 7.1 tests: the public key, the message and the
// signature, in hexadecimal.
fn check(pk: Str, msg: Str, sig: Str) -> Bool
    ed25519.verify(to32(hexb(pk)), to64(hexb(sig)), hostsrc.bytes_src(hexb(msg)))

// The same with byte `at` of the bytes `which` names XORed with `mask`.
fn flipped(pk: Str, msg: Str, sig: Str, which: Int, at: Int, mask: Int) -> Bool
    var p = hexb(pk)
    var m = hexb(msg)
    var s = hexb(sig)
    if which == 0
        p = bytes.set_u8(p, at, (bytes.byte_at(p, at) ?? 0) ^ mask)
    else if which == 1
        m = bytes.set_u8(m, at, (bytes.byte_at(m, at) ?? 0) ^ mask)
    else
        s = bytes.set_u8(s, at, (bytes.byte_at(s, at) ?? 0) ^ mask)
    ed25519.verify(to32(p), to64(s), hostsrc.bytes_src(m))

let PK1 = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
let SIG1 = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
let PK2 = "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
let MSG2 = "72"
let SIG2 = "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
let PK3 = "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025"
let MSG3 = "af82"
let SIG3 = "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"
let PKABC = "ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf"
let MSGABC = "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
let SIGABC = "dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b58909351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704"

@test
fn test_ed25519_rfc8032_valid()
    test.assert_true(check(PK1, "", SIG1), "test 1, the empty message")
    test.assert_true(check(PK2, MSG2, SIG2), "test 2, one byte")
    test.assert_true(check(PK3, MSG3, SIG3), "test 3, two bytes")
    test.assert_true(check(PKABC, MSGABC, SIGABC), "SHA(abc), 64 bytes")

@test
fn test_ed25519_one_bit_changed()
    // the message
    test.assert_false(flipped(PK2, MSG2, SIG2, 1, 0, 1), "a bit of the message changed")
    test.assert_false(flipped(PK3, MSG3, SIG3, 1, 1, 128), "a bit of the message changed")
    // R
    test.assert_false(flipped(PK1, "", SIG1, 2, 0, 1), "a bit of R changed")
    test.assert_false(flipped(PK2, MSG2, SIG2, 2, 17, 4), "a bit of R changed")
    // S
    test.assert_false(flipped(PK1, "", SIG1, 2, 32, 1), "a bit of S changed")
    test.assert_false(flipped(PKABC, MSGABC, SIGABC, 2, 40, 16), "a bit of S changed")
    // the key
    test.assert_false(flipped(PK1, "", SIG1, 0, 0, 1), "a bit of the key changed")
    test.assert_false(flipped(PK3, MSG3, SIG3, 0, 31, 128), "a bit of the key changed")

// S + L for test 1's S verifies on an implementation that skips the
// range check; RFC 8032 § 5.1.7 refuses it.
@test
fn test_ed25519_s_plus_l_refused()
    test.assert_false(check(PK1, "", "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901554c8c7872aa064e049dbb3013fbf29380d25bf5f0595bbe24655141438e7a101b"), "S + L")

// A key whose y is p or above is not canonical, and refused (§ 5.1.3).
@test
fn test_ed25519_non_canonical_key_refused()
    test.assert_false(check("edffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff7f", "", SIG1), "a key with y = p")

// Test 1024 of RFC 8032 § 7.1: a message of 1023 bytes, so SHA-512 runs
// over nine blocks.
let PK1024 = "278117fc144c72340f67d0f2316e8386ceffbf2b2428c9c51fef7c597f1d426e"
let MSG1024 = ""
let SIG1024 = "0aab4c900501b3e24d7cdf4663326a3a87df5e4843b2cbdb67cbf6e460fec350aa5371b1508f9f4528ecea23c436d94b5e8fcd4f681e30a6ac00a9704a188a03"

@test
fn test_ed25519_rfc8032_long_message()
    test.assert_true(check(PK1024, MSG1024, SIG1024), "test 1024, 1023 bytes")
    test.assert_false(flipped(PK1024, MSG1024, SIG1024, 1, 1000, 2), "a bit of the long message changed")
