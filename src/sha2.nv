// One block into a SHA-256 state, in place (FIPS 180-4 § 6.2.2).
@tier(embedded)
pub fn sha256_compress(var st: H8, var b: Blk)
    var w = sched_zero()
    for t in 0..16
        w.put(t, b.w[t])
    for t in 16..64
        let x = w.w[t - 15]
        let y = w.w[t - 2]
        let s0 = rotr32(x, 7) ^ rotr32(x, 18) ^ (x >>> 3)
        let s1 = rotr32(y, 17) ^ rotr32(y, 19) ^ (y >>> 10)
        w.put(t, (w.w[t - 16] + s0 + w.w[t - 7] + s1) & 0xFFFFFFFF)
    var a = st.h[0]
    var bb = st.h[1]
    var c = st.h[2]
    var d = st.h[3]
    var e = st.h[4]
    var f = st.h[5]
    var g = st.h[6]
    var h = st.h[7]
    for t in 0..64
        let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
        let ch = (e & f) ^ ((e ^ 0xFFFFFFFF) & g)
        let t1 = (h + s1 + ch + k256(t) + w.w[t]) & 0xFFFFFFFF
        let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
        let maj = (a & bb) ^ (a & c) ^ (bb & c)
        let t2 = (s0 + maj) & 0xFFFFFFFF
        h = g
        g = f
        f = e
        e = (d + t1) & 0xFFFFFFFF
        d = c
        c = bb
        bb = a
        a = (t1 + t2) & 0xFFFFFFFF
    st.put(0, (st.h[0] + a) & 0xFFFFFFFF)
    st.put(1, (st.h[1] + bb) & 0xFFFFFFFF)
    st.put(2, (st.h[2] + c) & 0xFFFFFFFF)
    st.put(3, (st.h[3] + d) & 0xFFFFFFFF)
    st.put(4, (st.h[4] + e) & 0xFFFFFFFF)
    st.put(5, (st.h[5] + f) & 0xFFFFFFFF)
    st.put(6, (st.h[6] + g) & 0xFFFFFFFF)
    st.put(7, (st.h[7] + h) & 0xFFFFFFFF)

// One block into a SHA-512 state, in place (FIPS 180-4 § 6.4.2).
@tier(embedded)
@wrapping
pub fn sha512_compress(var st: H8, var b: Blk)
    var w = sched_zero()
    for t in 0..16
        w.put(t, b.w[t])
    for t in 16..80
        let x = w.w[t - 15]
        let y = w.w[t - 2]
        let s0 = rotr64(x, 1) ^ rotr64(x, 8) ^ (x >>> 7)
        let s1 = rotr64(y, 19) ^ rotr64(y, 61) ^ (y >>> 6)
        w.put(t, w.w[t - 16] + s0 + w.w[t - 7] + s1)
    var a = st.h[0]
    var bb = st.h[1]
    var c = st.h[2]
    var d = st.h[3]
    var e = st.h[4]
    var f = st.h[5]
    var g = st.h[6]
    var h = st.h[7]
    for t in 0..80
        let s1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)
        let ch = (e & f) ^ (~e & g)
        let t1 = h + s1 + ch + k512(t) + w.w[t]
        let s0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)
        let maj = (a & bb) ^ (a & c) ^ (bb & c)
        let t2 = s0 + maj
        h = g
        g = f
        f = e
        e = d + t1
        d = c
        c = bb
        bb = a
        a = t1 + t2
    st.put(0, st.h[0] + a)
    st.put(1, st.h[1] + bb)
    st.put(2, st.h[2] + c)
    st.put(3, st.h[3] + d)
    st.put(4, st.h[4] + e)
    st.put(5, st.h[5] + f)
    st.put(6, st.h[6] + g)
    st.put(7, st.h[7] + h)
