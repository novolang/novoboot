// ed25519.nv: Ed25519 signature verification (RFC 8032 § 5.1.7), with
// nothing allocated and no randomness needed.
//
// A signature is R, the encoding of a point, and S, a scalar.  It is
// valid for the public key A and the message M when
//
//     [S]B = R + [k]A,   k = SHA-512(R || A || M) mod L,
//
// B being the curve's base point and L its prime order.  The check here
// computes [S]B + [k](-A) and compares its encoding with R's bytes.  The
// points are in extended twisted-Edwards coordinates (X : Y : Z : T),
// x = X/Z, y = Y/Z, xy = T/Z, with the addition and doubling formulas
// of Hisil, Wong, Carter and Dawson (2008) for a = -1, which RFC 8032
// § 5.1.4 prints.
//
// The checks RFC 8032 asks for, and the pitfalls the reference
// implementations read for this (SUPERCOP's ref10, TweetNaCl,
// Monocypher) document, each kept:
//
//   - S must be below L (§ 5.1.7 step 1).  Without it a signature has
//     a second valid form, S + L, the malleability ref10 originally
//     allowed and later releases refuse; `sc_below_l` refuses it.
//   - A's encoding must be canonical: a y of p or above is refused
//     (§ 5.1.3 step 1), where Monocypher and ref10 accept it.  R is
//     compared by bytes with an encoding this file writes, which is
//     always canonical, so a non-canonical R never matches.
//   - A point whose x^2 has no square root is not on the curve and is
//     refused (§ 5.1.3 step 3), as is x = 0 with the sign bit set
//     (step 4).
//   - The hash covers R, then A, then M, in that order, and its 512 bits
//     are reduced modulo L as one little-endian number (§ 5.1.7 step 2).
//   - The equation is checked without the cofactor 8, as ref10 and
//     libsodium check it; § 5.1.7 allows either.  A signature made by a
//     conforming signer verifies under both.
//   - Small-order public keys are not refused: the key a bootloader
//     checks against is built into its image, not chosen by whoever
//     supplies the image.
//
// Nothing here is secret, so the double-scalar multiplication is a
// plain double-and-add whose time depends on the scalars.

use bytes32
use fe25519

pub @value
struct Ge
    x: Fe
    y: Fe
    z: Fe
    t: Fe

@tier(embedded)
pub fn ge_identity() -> Ge
    Ge { x: fe25519.fe_zero(), y: fe25519.fe_one(), z: fe25519.fe_one(), t: fe25519.fe_zero() }

// The base point B: y = 4/5, x the even root (RFC 8032 § 5.1).
@tier(embedded)
pub fn ge_base() -> Ge
    Ge { x: Fe { v: [0x325d51a, 0x18b5823, 0xf6592a, 0x104a92d, 0x1a4b31d,
                     0x1d6dc5c, 0x27118fe, 0x7fd814, 0x13cd6e5, 0x85a4db] },
         y: Fe { v: [0x2666658, 0x1999999, 0xcccccc, 0x1333333, 0x1999999,
                     0x666666, 0x3333333, 0xcccccc, 0x2666666, 0x1999999] },
         z: fe25519.fe_one(),
         t: Fe { v: [0x1b7dda3, 0x1a2ace9, 0x25eadbb, 0x3ba8a, 0x83c27e,
                     0xabe37d, 0x1274732, 0xccacdd, 0xfd78b7, 0x19e1d7c] } }

// The four products both formulas end with: X = EF, Y = GH, Z = FG,
// T = EH.
@tier(embedded)
fn ge_finish(var r: Ge, var e: Fe, var f: Fe, var g: Fe, var h: Fe)
    fe25519.fe_mul(var r.x, var e, var f)
    fe25519.fe_mul(var r.y, var g, var h)
    fe25519.fe_mul(var r.z, var f, var g)
    fe25519.fe_mul(var r.t, var e, var h)

// r = P + Q, "add-2008-hwcd-3" for a = -1 (RFC 8032 § 5.1.4).  r may
// be P or Q: every coordinate of both is read before r is written.
@tier(embedded)
pub fn ge_add(var r: Ge, var p: Ge, var q: Ge)
    var a = fe25519.fe_zero()
    var b = fe25519.fe_zero()
    var c = fe25519.fe_zero()
    var d = fe25519.fe_zero()
    var u = fe25519.fe_zero()
    fe25519.fe_sub(var a, var p.y, var p.x)
    fe25519.fe_sub(var u, var q.y, var q.x)
    fe25519.fe_mul(var a, var a, var u)
    fe25519.fe_add(var b, var p.y, var p.x)
    fe25519.fe_add(var u, var q.y, var q.x)
    fe25519.fe_mul(var b, var b, var u)
    var d2 = fe25519.fe_d2()
    fe25519.fe_mul(var c, var p.t, var d2)
    fe25519.fe_mul(var c, var c, var q.t)
    fe25519.fe_add(var d, var p.z, var p.z)
    fe25519.fe_mul(var d, var d, var q.z)
    var e = fe25519.fe_zero()
    var f = fe25519.fe_zero()
    var g = fe25519.fe_zero()
    var h = fe25519.fe_zero()
    fe25519.fe_sub(var e, var b, var a)
    fe25519.fe_sub(var f, var d, var c)
    fe25519.fe_add(var g, var d, var c)
    fe25519.fe_add(var h, var b, var a)
    ge_finish(var r, var e, var f, var g, var h)

// r = 2P, "dbl-2008-hwcd" for a = -1, with every intermediate negated,
// which leaves the products as they are and saves the negation of x^2.
// r may be P.
@tier(embedded)
pub fn ge_dbl(var r: Ge, var p: Ge)
    var a = fe25519.fe_zero()
    var b = fe25519.fe_zero()
    var c = fe25519.fe_zero()
    var u = fe25519.fe_zero()
    fe25519.fe_sq(var a, var p.x)
    fe25519.fe_sq(var b, var p.y)
    fe25519.fe_sq(var c, var p.z)
    fe25519.fe_add(var c, var c, var c)
    var h = fe25519.fe_zero()
    fe25519.fe_add(var h, var a, var b)
    fe25519.fe_add(var u, var p.x, var p.y)
    fe25519.fe_sq(var u, var u)
    var e = fe25519.fe_zero()
    fe25519.fe_sub(var e, var h, var u)
    var g = fe25519.fe_zero()
    fe25519.fe_sub(var g, var a, var b)
    var f = fe25519.fe_zero()
    fe25519.fe_add(var f, var c, var g)
    ge_finish(var r, var e, var f, var g, var h)

// r = -P.
@tier(embedded)
pub fn ge_neg(var r: Ge, var p: Ge)
    fe25519.fe_neg(var r.x, var p.x)
    r.y = p.y
    r.z = p.z
    fe25519.fe_neg(var r.t, var p.t)

// The 32-byte encoding of P, written into `out`: y, with x's least
// significant bit in the top bit (RFC 8032 § 5.1.2).
@tier(embedded)
pub fn ge_encode(var out: B32, var p: Ge)
    var zi = fe25519.fe_zero()
    fe25519.fe_invert(var zi, var p.z)
    var x = fe25519.fe_zero()
    var y = fe25519.fe_zero()
    fe25519.fe_mul(var x, var p.x, var zi)
    fe25519.fe_mul(var y, var p.y, var zi)
    fe25519.fe_to_bytes(var out, var y)
    out.b[31] = out.b[31] | ((if fe25519.fe_is_odd(var x) then 128 else 0) as u8)

// The point a 32-byte encoding names (RFC 8032 § 5.1.3), written into
// `r`; false, with `r` left as it was, when y is not below p, when x^2
// has no square root, or when x is 0 and the sign bit is set.
@tier(embedded)
pub fn ge_decode(var r: Ge, var s: B32) -> Bool
    let sign = ((s.b[31] as Int) >> 7) & 1
    var y = fe25519.fe_zero()
    fe25519.fe_from_bytes(var y, var s)
    // Canonical: the bytes of y below p are the input's, top bit aside.
    var back = bytes32.b32_zero()
    fe25519.fe_to_bytes(var back, var y)
    var same = true
    for i in 0..32
        let want = if i == 31 then (s.b[31] as Int) & 127 else s.b[i] as Int
        same = same and back.b[i] as Int == want
    if not same
        return false
    var one = fe25519.fe_one()
    var u = fe25519.fe_zero()
    fe25519.fe_sq(var u, var y)
    var v = fe25519.fe_d()
    fe25519.fe_mul(var v, var v, var u)
    fe25519.fe_add(var v, var v, var one)
    fe25519.fe_sub(var u, var u, var one)
    // x = u v^3 (u v^7)^((p - 5) / 8)
    var v3 = fe25519.fe_zero()
    fe25519.fe_sq(var v3, var v)
    fe25519.fe_mul(var v3, var v3, var v)
    var t = fe25519.fe_zero()
    fe25519.fe_sq(var t, var v3)
    fe25519.fe_mul(var t, var t, var v)
    fe25519.fe_mul(var t, var t, var u)
    fe25519.fe_pow2523(var t, var t)
    var x = fe25519.fe_zero()
    fe25519.fe_mul(var x, var u, var v3)
    fe25519.fe_mul(var x, var x, var t)
    // v x^2 is u when x is the root, -u when x times sqrt(-1) is; neither
    // when u / v has no square root and the bytes name no point.
    var vxx = fe25519.fe_zero()
    fe25519.fe_sq(var vxx, var x)
    fe25519.fe_mul(var vxx, var vxx, var v)
    let root = fe25519.fe_eq(var vxx, var u)
    fe25519.fe_neg(var t, var u)
    if not root and not fe25519.fe_eq(var vxx, var t)
        return false
    if not root
        var m = fe25519.fe_sqrtm1()
        fe25519.fe_mul(var x, var x, var m)
    if fe25519.fe_is_zero(var x) and sign == 1
        // cov: skip — runs only for the encoding of x = 0 with the sign bit set, which no public key is
        return false
    if (if fe25519.fe_is_odd(var x) then 1 else 0) != sign
        fe25519.fe_neg(var x, var x)
    r.x = x
    r.y = y
    r.z = one
    fe25519.fe_mul(var r.t, var x, var y)
    true

// ── Scalars modulo L ─────────────────────────────────────────────────

// A scalar as eight 32-bit words, least significant first.
pub @value
struct Sc
    w: [Int; 8]

impl Sc
    @tier(embedded)
    fn put(var self, k: Int, x: Int)
        self.w[k] = x

@tier(embedded)
fn sc_zero() -> Sc
    Sc { w: [0, 0, 0, 0, 0, 0, 0, 0] }

// L = 2^252 + 27742317777372353535851937790883648493, by word.
@tier(embedded)
fn l_word(k: Int) -> Int
    match k
        0 => 0x5cf5d3ed
        1 => 0x5812631a
        2 => 0xa2f79cd6
        3 => 0x14def9de
        7 => 0x10000000
        _ => 0

// Whether s >= L.
@tier(embedded)
fn sc_ge_l(var s: Sc) -> Bool
    for n in 0..8
        let k = 7 - n
        if s.w[k] != l_word(k)
            return s.w[k] > l_word(k)
    // cov: skip — runs only when s is L exactly, which a signature's S is with probability 2^-253 and the reduction's remainder about as rarely
    true

// s = s - L, for s >= L.
@tier(embedded)
fn sc_sub_l(var s: Sc)
    var borrow = 0
    for k in 0..8
        var d = s.w[k] - l_word(k) - borrow
        borrow = 0
        if d < 0
            d = d + 0x100000000
            borrow = 1
        s.w[k] = d

// s = 2s + bit.
@tier(embedded)
fn sc_shl1(var s: Sc, bit: Int)
    var c = bit
    for k in 0..8
        let top = s.w[k] >>> 31
        s.w[k] = ((s.w[k] << 1) | c) & 0xFFFFFFFF
        c = top

// The 64-byte little-endian number `h` modulo L, as 32 bytes written
// into `out`: a bit at a time from the top, doubling the remainder and
// taking L off when it reaches it.  512 steps of eight words, which
// costs far less than one point operation.
@tier(embedded)
pub fn sc_reduce64(var out: B32, var h: B64)
    var r = sc_zero()
    for n in 0..512
        let i = 511 - n
        sc_shl1(var r, ((h.b[i >> 3] as Int) >> (i & 7)) & 1)
        if sc_ge_l(var r)
            sc_sub_l(var r)
    for k in 0..8
        for j in 0..4
            out.b[4 * k + j] = ((r.w[k] >> (8 * j)) & 255) as u8

// Whether the 32-byte little-endian scalar `s` is below L.
@tier(embedded)
pub fn sc_below_l(var s: B32) -> Bool
    var w = sc_zero()
    for k in 0..8
        w.put(k, (s.b[4 * k] as Int) | ((s.b[4 * k + 1] as Int) << 8)
                 | ((s.b[4 * k + 2] as Int) << 16) | ((s.b[4 * k + 3] as Int) << 24))
    not sc_ge_l(var w)

@tier(embedded)
fn bit_of(var s: B32, i: Int) -> Int
    ((s.b[i >> 3] as Int) >> (i & 7)) & 1

// acc = [s]B + [k]P for scalars below L, which have no bit past 252: one
// doubling per bit, and an addition of B, P or B + P where the bits ask
// for one (Straus's joint form).
@tier(embedded)
pub fn double_scalar_mul(var acc: Ge, var s: B32, var k: B32, var p: Ge)
    var b = ge_base()
    var bp = ge_identity()
    ge_add(var bp, var b, var p)
    acc = ge_identity()
    for n in 0..253
        let i = 252 - n
        ge_dbl(var acc, var acc)
        let sb = bit_of(var s, i)
        let kb = bit_of(var k, i)
        if sb == 1 and kb == 1
            ge_add(var acc, var acc, var bp)
        else if sb == 1
            ge_add(var acc, var acc, var b)
        else if kb == 1
            ge_add(var acc, var acc, var p)

// ── SHA-512 over R || A || M ─────────────────────────────────────────

use sha2

// Byte `i` of R || A || M.
@tier(embedded)
fn ram_at<S: ByteSource[e]>(var r: B32, var a: B32, msg: S, i: Int, total: Int) -> Int [e]
    if i < 32
        return r.b[i] as Int
    if i < 64
        return a.b[i - 32] as Int
    if i < total
        return msg.src_at(i - 64)
    if i == total
        return 0x80
    0

// The padded message's block starting at byte `base`, as sixteen
// big-endian eight-byte words written into `blk`; the last sixteen bytes
// of the last block are the message's length in bits (FIPS 180-4
// § 5.1.2), whose upper half is zero for any message here.
@tier(embedded)
fn ram_block<S: ByteSource[e]>(var blk: Blk, var r: B32, var a: B32, msg: S, base: Int,
                               total: Int, padded: Int) [e]
    for k in 0..16
        let off = base + 8 * k
        var w = 0
        if off == padded - 8
            w = total * 8
        else
            for j in 0..8
                w = (w << 8) | ram_at(var r, var a, msg, off + j, total)
        blk.w[k] = w

// SHA-512(R || A || M), as 64 bytes written into `out`.
@tier(embedded)
pub fn sha512_ram<S: ByteSource[e]>(var out: B64, var r: B32, var a: B32, msg: S) [e]
    let total = 64 + msg.src_len()
    let padded = (total + 17 + 127) / 128 * 128
    var st = sha2.sha512_init()
    var blk = sha2.blk_zero()
    for n in 0..(padded / 128)
        ram_block(var blk, var r, var a, msg, n * 128, total, padded)
        sha2.sha512_compress(var st, var blk)
    for i in 0..8
        out.put_be64(8 * i, st.h[i])

// ── The check ────────────────────────────────────────────────────────

// Whether `sig` is an Ed25519 signature of the message `msg` under the
// public key `pk` (RFC 8032 § 5.1.7).
@tier(embedded)
pub fn verify<S: ByteSource[e]>(pk: B32, sig: B64, msg: S) -> Bool [e]
    var key = pk
    var sg = sig
    var r = bytes32.b32_zero()
    var s = bytes32.b32_zero()
    sg.half_into(var r, false)
    sg.half_into(var s, true)
    if not sc_below_l(var s)
        return false
    var a = ge_identity()
    if not ge_decode(var a, var key)
        return false
    ge_neg(var a, var a)
    var h = bytes32.b64_zero()
    sha512_ram(var h, var r, var key, msg)
    var k = bytes32.b32_zero()
    sc_reduce64(var k, var h)
    var acc = ge_identity()
    double_scalar_mul(var acc, var s, var k, var a)
    var enc = bytes32.b32_zero()
    ge_encode(var enc, var acc)
    bytes32.b32_eq(var enc, var r)
